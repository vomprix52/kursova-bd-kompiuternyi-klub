erDiagram
  audit_log {
    bigint audit_id PK
    varchar_40 table_name
    int record_id
    enum action
    varchar_40 field_name
    varchar_255 old_value
    varchar_255 new_value
    smallint employee_id FK
    varchar_80 changed_by
    datetime changed_at
  }
  balance_transaction {
    int tx_id PK
    int client_id FK
    enum tx_type
    decimal_10_2 amount
    decimal_10_2 balance_after
    enum payment_method
    int sale_id FK
    smallint employee_id FK
    datetime created_at
  }
  booking {
    int booking_id PK
    int client_id FK
    smallint computer_id FK
    datetime starts_at
    datetime ends_at
    enum status
    datetime created_at
    smallint created_by FK
  }
  client {
    int client_id PK
    varchar_30 login UK
    varchar_255 password_hash
    varchar_50 last_name
    varchar_50 first_name
    varchar_13 phone UK
    varchar_100 email UK
    date birth_date
    decimal_10_2 balance
    decimal_12_2 total_spent
    tinyint level_id FK
    enum status
    datetime registered_at
  }
  computer {
    smallint computer_id PK
    varchar_6 seat_label UK
    tinyint zone_id FK
    smallint config_id FK
    varchar_15 ip_address UK
    enum status
    date installed_at
  }
  employee {
    smallint employee_id PK
    varchar_50 last_name
    varchar_50 first_name
    varchar_13 phone UK
    varchar_30 login UK
    varchar_255 password_hash
    tinyint position_id FK
    date hired_at
    tinyint_1 is_active
  }
  game_session {
    int session_id PK
    int client_id FK
    smallint computer_id FK
    smallint tariff_id FK
    int shift_id FK
    int booking_id FK,UK
    datetime started_at
    datetime planned_end
    datetime ended_at
    smallint minutes_used
    decimal_4_2 discount_pct
    decimal_10_2 cost
    enum status
  }
  loyalty_level {
    tinyint level_id PK
    varchar_30 name UK
    decimal_10_2 min_spent UK
    decimal_4_2 discount_pct
  }
  maintenance_request {
    int request_id PK
    smallint computer_id FK
    smallint reported_by FK
    smallint assigned_to FK
    varchar_255 problem
    enum priority
    enum status
    datetime created_at
    datetime resolved_at
    varchar_255 resolution
  }
  pc_config {
    smallint config_id PK
    varchar_40 name UK
    varchar_60 cpu
    varchar_60 gpu
    smallint ram_gb
    varchar_60 storage
    varchar_80 monitor
    smallint refresh_hz
  }
  position {
    tinyint position_id PK
    varchar_40 title UK
    decimal_7_2 hourly_rate
  }
  product {
    smallint product_id PK
    tinyint category_id FK
    varchar_60 name UK
    decimal_8_2 price
    int stock_qty
    tinyint_1 is_active
  }
  product_category {
    tinyint category_id PK
    varchar_40 name UK
  }
  sale {
    int sale_id PK
    enum sale_type
    int session_id FK,UK
    int client_id FK
    smallint employee_id FK
    int shift_id FK
    datetime created_at
    enum payment_method
    decimal_10_2 total
  }
  sale_item {
    int sale_id PK,FK
    smallint product_id PK,FK
    smallint quantity
    decimal_8_2 unit_price
  }
  shift {
    int shift_id PK
    smallint employee_id FK
    datetime started_at
    datetime ended_at
    decimal_10_2 cash_start
    decimal_10_2 cash_end
  }
  tariff {
    smallint tariff_id PK
    tinyint zone_id FK
    varchar_40 name
    enum tariff_type
    decimal_8_2 price
    smallint duration_min
    tinyint start_from_h
    tinyint start_to_h
    tinyint_1 is_active
  }
  zone {
    tinyint zone_id PK
    char_3 code UK
    varchar_40 name UK
    varchar_255 description
  }
